NODE_ENV=production
SERVER_PORT=4000
CLIENT_ORIGIN=https://your-client-domain.example

BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REDIRECT_URI=https://your-server-domain.example/api/bitrix/oauth/callback
BITRIX_WEBHOOK_URL=
BITRIX_ALLOWED_DOMAINS=your-company.bitrix24.com
BITRIX_AUTH_REQUIRED=true
BITRIX_SESSION_TTL_SECONDS=28800

AMERIA_BASE_URL=https://online.ameriabank.am/OnlineBanking/CorporateApi/
# Local development only. Leave empty in production; production connects directly.
AMERIA_PROXY_URL=
Ameria_access_Key=
AMERIA_APPLICATION_NAME=MilonAmeriaIntegration
AMERIA_AUTH_PATH=/authentication/v1/authenticate
AMERIA_REFRESH_PATH=/authentication/v1/refresh
AMERIA_AUTH_MODE=json
AMERIA_ACCOUNTS_PATH=/accounts/v1/get-list
AMERIA_TRANSACTIONS_PATH=/accounts/v1/transactions
AMERIA_SYNC_ENABLED=false
AMERIA_SYNC_RUN_ON_START=false
AMERIA_SYNC_INTERVAL_MS=300000
AMERIA_SYNC_FROM_DATE=2026-01-01

ACTIVITY_LOG_PATH=data/activity-log.json
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=milon_ameria
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
ADMIN_ACCESS_TOKEN=
BITRIX_REFRESH_STAGE_IDS=false

# Additive matching layer (smartMatch + parsePurposeV2). Legacy behaviour is unchanged while false.
SMART_MATCH_V2=false
