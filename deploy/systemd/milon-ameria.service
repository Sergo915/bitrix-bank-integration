[Unit]
Description=Milon Ameria Bitrix integration server
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/milon-ameria
Environment=NODE_ENV=production
Environment=MILON_ENV_FILE=/var/www/milon-ameria.env
EnvironmentFile=/var/www/milon-ameria.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
