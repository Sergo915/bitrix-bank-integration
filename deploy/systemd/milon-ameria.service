[Unit]
Description=Milon Ameria Bitrix integration server
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/milon-ameria
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
