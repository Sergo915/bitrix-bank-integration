[Unit]
Description=Milon Ameria Bitrix integration server
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/bitrix-connector
Environment=NODE_ENV=production
EnvironmentFile=/var/www/.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
